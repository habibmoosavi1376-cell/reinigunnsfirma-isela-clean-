# ------------------------------------------------------------------
# ISELA CLEAN – Vorlage für Umgebungsvariablen (apps/web + CLI-Skripte)
#
# - Diese Datei enthält KEINE echten Werte und darf keine enthalten.
# - Lokal kopieren nach .env.local (per .gitignore ausgeschlossen).
# - Produktionswerte ausschließlich im Secret-Store der Hosting-Plattform.
# - Alle Variablen werden beim Start per Zod-Schema validiert (packages/config).
#   Fehlende oder ungültige Pflichtwerte => der Server beendet sich mit Exit-Code 1
#   und nennt nur die Variablennamen, niemals Werte.
# - Es gibt KEINE öffentlichen (NEXT_PUBLIC_*) Variablen. Alle Werte sind server-only
#   und gelangen nie in Client-Bundles (CI prüft das mit Canary-Werten).
# ------------------------------------------------------------------

# === APPLICATION ======================================================
NODE_ENV=development
# Öffentliche Basis-URL (Origin-Prüfung, Links in E-Mails, Canonical/SEO).
# In Produktion Pflicht: https (Ausnahme nur Loopback für lokale Produktions-Tests).
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Europe/Berlin
APP_DEFAULT_LOCALE=de-DE
APP_DEFAULT_CURRENCY=EUR

# === DATABASE (PostgreSQL 16 + PostGIS 3.4) ============================
# Format: postgres://USER:PASSWORD@HOST:PORT/DB  – Pflicht.
DATABASE_URL=

# === AUTH (Better Auth) ===============================================
# Zufallswert >= 32 Zeichen, z. B. `openssl rand -base64 48` – Pflicht, keine Platzhalter.
AUTH_SECRET=
# Zusätzliche vertrauenswürdige Origins (kommagetrennt). Der Origin von APP_BASE_URL ist
# immer enthalten. Leer lassen, wenn es keine weiteren Frontends gibt.
AUTH_TRUSTED_ORIGINS=
# Header mit der Client-IP, gesetzt vom eigenen Reverse Proxy (Standard: x-forwarded-for),
# und die Adressen dieser Proxies (CIDR, kommagetrennt).
AUTH_IP_ADDRESS_HEADERS=
AUTH_TRUSTED_PROXIES=

# === SECURITY ==========================================================
# Secret pepper (>= 32 Zeichen) für Identitäts-Hashes (Dublettenerkennung, Rate-Limit-Keys).
# Niemals ändern ohne Re-Hashing-Plan: bestehende Hashes würden ungültig. – Pflicht.
IDENTITY_HASH_PEPPER=
# Öffentliche Anfragen ("Reinigung anfragen") pro Client und Stunde (1–100, Standard 5).
PUBLIC_REQUEST_RATE_LIMIT_PER_HOUR=5

# === EMAIL (SMTP) ======================================================
# Einziger unterstützter Provider: smtp. – Pflicht.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
# true = implizites TLS (Port 465). Sonst ist STARTTLS in Produktion verpflichtend
# (Ausnahme: Relay auf demselben Host/Loopback).
SMTP_SECURE=
# Nur gemeinsam setzen (oder beide leer lassen).
SMTP_USER=
SMTP_PASSWORD=

# === GEO ===============================================================
# Noch kein Geocoding-Anbieter integriert. Ein gesetzter Wert wird beim Start ABGELEHNT
# (kein Fake-Geocoding). Anfragen erhalten bis dahin service_area_status = UNKNOWN.
GEOCODING_PROVIDER=

# === PAYMENT ===========================================================
# Noch kein Zahlungsanbieter integriert (ADR-010). Ein gesetzter Wert wird ABGELEHNT
# (keine Fake-Zahlung).
PAYMENT_PROVIDER=

# === STORAGE ===========================================================
# Noch kein Objektspeicher integriert. Ein gesetzter Wert wird ABGELEHNT.
STORAGE_ENDPOINT=

# === OBSERVABILITY =====================================================
# debug | info | warn | error
LOG_LEVEL=info

# === LEGAL (Impressum, § 5 DDG) ========================================
# In Produktion Pflicht (außer Telefon/USt-IdNr.). Nur echte Angaben – nichts erfinden.
BUSINESS_LEGAL_NAME=
BUSINESS_REPRESENTATIVE=
BUSINESS_STREET=
BUSINESS_POSTAL_CODE=
BUSINESS_CITY=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_VAT_ID=

# === TESTS (nur lokal/CI, niemals in Produktion) =======================
# Integrationstests: Datenbankname MUSS "test" enthalten (Schema wird neu aufgesetzt).
TEST_DATABASE_URL=
# E2E-Tests (Playwright): Datenbankname MUSS "e2e" enthalten (Schema wird neu aufgesetzt).
E2E_DATABASE_URL=
# Optional: vorinstalliertes Chromium statt `playwright install`.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
