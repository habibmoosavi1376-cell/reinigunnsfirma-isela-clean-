# ------------------------------------------------------------------
# ISELA CLEAN – Vorlage für Umgebungsvariablen
#
# - Diese Datei enthält KEINE echten Werte und darf keine enthalten.
# - Lokal kopieren nach .env.local (per .gitignore ausgeschlossen).
# - Produktionswerte ausschließlich im Secret-Store der Hosting-Plattform.
# - Ab Phase 1 werden alle Variablen beim Start per Zod-Schema validiert
#   (packages/config). Fehlende Pflichtwerte => Start bricht ab.
# - Status: Vorschlag für die Zielarchitektur (docs/ARCHITECTURE.md).
# ------------------------------------------------------------------

# --- Laufzeit ---------------------------------------------------------
NODE_ENV=development
# Öffentliche Basis-URL (für Redirect-Allowlist, Links in E-Mails, SEO)
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Europe/Berlin
APP_DEFAULT_LOCALE=de-DE
APP_DEFAULT_CURRENCY=EUR
LOG_LEVEL=info

# --- Datenbank (PostgreSQL + PostGIS) ---------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=
# Separater Nutzer mit DDL-Rechten nur für Migrationen
DATABASE_MIGRATION_URL=

# --- Authentifizierung / Sessions -------------------------------------
# Zufallswert >= 32 Byte, z. B. `openssl rand -base64 32`
AUTH_SECRET=
SESSION_MAX_AGE_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=86400
# Header(s) with the client IP set by the reverse proxy, and the proxies' addresses (CIDR)
AUTH_IP_ADDRESS_HEADERS=x-forwarded-for
AUTH_TRUSTED_PROXIES=

# --- CRM ---------------------------------------------------------------
# Secret pepper (>= 32 Zeichen) für Identitäts-Hashes (Dublettenerkennung).
# Niemals ändern ohne Re-Hashing-Plan: bestehende Hashes würden ungültig.
IDENTITY_HASH_PEPPER=

# --- Tests (nur lokal/CI) --------------------------------------------
# Datenbankname MUSS "test" enthalten; die Integrationstests setzen das Schema neu auf.
TEST_DATABASE_URL=

# --- Zahlungsanbieter (Anbieter noch offen, siehe ADR-010) ------------
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- E-Mail-Versand ---------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Geocoding (Einsatzgebiete) ---------------------------------------
GEOCODING_PROVIDER=
GEOCODING_API_KEY=

# --- Datei-Uploads (privater Objektspeicher, EU-Region) ---------------
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=10485760

# --- Sicherheit -------------------------------------------------------
# Kommagetrennte Allowlist für ausgehende HTTP-Requests (SSRF-Schutz)
OUTBOUND_HOST_ALLOWLIST=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# --- Fehler-Tracking (optional, EU-Datenresidenz) ---------------------
ERROR_TRACKING_DSN=
